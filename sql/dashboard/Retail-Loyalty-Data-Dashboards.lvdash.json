{
  "datasets": [
    {
      "name": "6a30cffb",
      "displayName": "gold_customer_transactions",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.gold_customer_transactions",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "39cbc52f",
      "displayName": "average_basket",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        SUM(recorded_sales) /\r\n",
        "        COUNT(DISTINCT transaction_id),\r\n",
        "        2\r\n",
        "    ) AS average_basket\r\n",
        "FROM workspace.gold.gold_customer_transactions;"
      ]
    },
    {
      "name": "a1118899",
      "displayName": "average_spend_per_member",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        SUM(recorded_sales) /\r\n",
        "        COUNT(DISTINCT customer_id),\r\n",
        "        2\r\n",
        "    ) AS average_spend_per_member\r\n",
        "FROM workspace.gold.gold_customer_transactions;"
      ]
    },
    {
      "name": "2d9ddd7f",
      "displayName": "transactions_per_member",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        COUNT(DISTINCT transaction_id) /\r\n",
        "        COUNT(DISTINCT customer_id),\r\n",
        "        2\r\n",
        "    ) AS transactions_per_member\r\n",
        "FROM workspace.gold.gold_customer_transactions;"
      ]
    },
    {
      "name": "338cac6a",
      "displayName": "average_spend_by_age_group",
      "queryLines": [
        "SELECT\r\n",
        "    age_group,\r\n",
        "    ROUND(\r\n",
        "        SUM(recorded_sales) /\r\n",
        "        COUNT(DISTINCT customer_id),\r\n",
        "        2\r\n",
        "    ) AS average_spend_per_member\r\n",
        "FROM workspace.gold.gold_customer_transactions\r\n",
        "WHERE age_group IS NOT NULL\r\n",
        "GROUP BY age_group\r\n",
        "ORDER BY average_spend_per_member DESC;"
      ]
    }
  ],
